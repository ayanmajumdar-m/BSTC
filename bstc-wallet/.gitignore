# ------------------------------------------------------------
# Wallet / Crypto Sensitive Files
#
# NEVER commit recovery phrases, private keys, seed files,
# wallet backups, or local secret material.
# ------------------------------------------------------------

*.mnemonic
*.seed
*.secret
*.secrets

*.privatekey
*.private-key
*.private_key

*.wallet
*.wallet.json

# Recovery phrases
seed-phrase*
seed_phrase*
mnemonic*
recovery-phrase*
recovery_phrase*

# Wallet backups
wallet-backup*
wallet_backup*
*.wallet-backup


